# ─── OpenAI (required for /social-post) ─────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# ─── Server binding ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8008
LOG_LEVEL=INFO

# ─── Security ───────────────────────────────────────────────────────────────
# Shared secret between Laravel and this service. Leave empty to disable auth.
# When set, callers MUST send an `X-Service-Token: <value>` header.
SERVICE_TOKEN=

# Comma-separated origins for CORS. Leave empty for server-to-server only.
ALLOWED_ORIGINS=
# Set to 1 to allow any origin (development only).
ALLOW_ANY_ORIGIN=0
