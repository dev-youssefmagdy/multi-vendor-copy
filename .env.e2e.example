# Browser E2E suite (Playwright, dedup plan Phase 8). Copy to .env.e2e (gitignored) and adjust.
# Never point this at a production host: `php artisan e2e:prepare` creates the dedicated tenants
# e2e-sync / e2e-central and E2E users/fixtures in the database the app is configured with.

# Central host; tenants are served at http://<tenant-id>.<E2E_CENTRAL_DOMAIN>
E2E_CENTRAL_DOMAIN=dokan-v2.loc
E2E_SCHEME=http

# Password of every E2E account (central admin, tenant owner / staff, customer). Also read by e2e:prepare.
E2E_PASSWORD=change-me-locally
E2E_ADMIN_EMAIL=e2e-admin@e2e.test

# Resolve *.E2E_CENTRAL_DOMAIN to this IP inside Chromium (no /etc/hosts edits needed).
E2E_HOST_IP=127.0.0.1

# Workers (fullyParallel). The order lifecycle spec is serial inside each mode project.
E2E_WORKERS=4

# 1 = do not run `php artisan e2e:prepare` in global setup (fixtures already prepared).
E2E_SKIP_PREPARE=0

# PHP binary used for `php artisan e2e:prepare` / `e2e:inspect`.
E2E_PHP=php

# Real tenant for the non-destructive `vendor` smoke project (read-only probe + impersonation). Empty = skipped.
# May also be set in the app .env: E2E_* keys there are read with the lowest priority (.env < .env.e2e < process env).
E2E_VENDOR_TENANT=
